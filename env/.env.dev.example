# Copy these keys to env/.env.dev.user and fill them before provisioning/deploying.
# Never commit env/.env.dev.user. Recovered secret values are intentionally absent.

# Existing Microsoft Entra bot app registration
SECRET_BOT_PASSWORD=

# LLM provider credentials (LLM_PRIMARY=groq in env/.env.dev)
SECRET_GROQ_API_KEY=
SECRET_OPENAI_API_KEY=

# Turso Cloud operational database
SECRET_TURSO_DATABASE_URL=
SECRET_TURSO_AUTH_TOKEN=

# Dynamics 365 application credential
SECRET_D365_CLIENT_SECRET=

# Protects /internal/cron/* HTTP endpoints
SECRET_LTM_CRON_SECRET=
